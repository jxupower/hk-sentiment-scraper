# Copy this file to .env and fill in values you have. All keys are optional —
# the app degrades gracefully when a key is missing.
#
# SECURITY: `.env` is `.gitignore`d — never commit real credentials. If you
# suspect a leak (accidentally staged, pasted into chat, printed to a shared
# terminal log), ROTATE the affected credential in the upstream console
# immediately — the file's presence on disk is the audit trail, not the fix.

# ------------------ Optional API credentials ------------------

# Reddit (for r/HKstocks etc. scraper). Without these the Reddit source is
# silently skipped.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SentimentScraper/1.0

# Claude AI (for sentiment scoring + AI sector/business summaries + devil's
# advocate). VADER is used as fallback when this is missing.
CLAUDE_API_KEY=

# ------------------ Dashboard ------------------

DASHBOARD_PORT=8050
DASHBOARD_DEBUG=false

# Auth: when the dashboard runs BEHIND Cloudflare Access, set this to `true`
# so `dashboard/app.py` will trust the `Cf-Access-Authenticated-User-Email`
# header for logging + any future per-user features. LEAVE UNSET for local
# dev or any direct-exposure deployment — the header is client-settable and
# will be spoofed the moment it becomes an authz signal.
TRUST_CF_ACCESS_HEADER=false

# ------------------ Scraping cadence ------------------

SCRAPE_INTERVAL_MINUTES=30
MAX_ARTICLES_PER_SOURCE=50
SENTIMENT_HISTORY_DAYS=90

# ------------------ Supabase (cloud DB for prices + fundamentals) ------------------

# Toggle: when "true", historical_prices + fundamentals_snapshots reads/writes
# go to Supabase Postgres. When "false" or unset, falls back to local SQLite.
USE_CLOUD_DB=false

# Direct Postgres connection string from your Supabase project.
#
# USE THE LIMITED `app_backend` ROLE, NOT `postgres`. The migration in
# docs/supabase_rls_migration.md creates `app_backend` with DML-only
# grants + RLS enforcement. The `postgres` credential remains superuser
# and should stay OUT of any long-lived config — use it only from the
# Supabase SQL Editor for schema migrations.
#
# Format (session pooler): app_backend.<project-ref> as the user.
#   postgresql://app_backend.<ref>:<pw>@aws-<region>.pooler.supabase.com:5432/postgres
# URL-encode `@` (%40), `+` (%2B), `%` (%25) if present in the password.
SUPABASE_DB_URL=
